    "license": "AGPL-3.0",
    "notes": [
        "MarkFlowy stores settings and user data outside the Scoop app directory, so upgrades retain your configuration.",
        "Optional file associations (.md, .markdown, .json, .txt): powershell -ExecutionPolicy Bypass -File \"$dir\\markflowy-file-assoc.ps1\"",
        "The script reports any extension whose per-user default (Open with -> Always use this app) already points to another app; Windows gives that choice priority, so repoint it manually if you want MarkFlowy there.",
        "Remove the associations later with: powershell -ExecutionPolicy Bypass -File \"$dir\\markflowy-file-assoc.ps1\" -Uninstall"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/drl990114/MarkFlowy/releases/download/v1.1.0/MarkFlowy_v1.1.0_x64_portable.zip",
