{
    "version": "1.2.3",
    "description": "Local-first Markdown editor with visual, source, and reading modes",
    "homepage": "https://github.com/drl990114/MarkFlowy",
    "license": "AGPL-3.0",
    "notes": [
        "MarkFlowy stores settings and user data outside the Scoop app directory, so upgrades retain your configuration.",
        "File associations (.md, .markdown, .json, .txt) are re-registered automatically on install and update, pointing at the stable apps\\markflowy\\current junction.",
        "Windows gives an explicit per-user choice (Open with -> Always use this app) priority over these defaults; switch via right-click -> Open with -> Choose another app.",
        "Manual re-run or removal: powershell -ExecutionPolicy Bypass -File \"$dir\\markflowy-file-assoc.ps1\" (append -Uninstall to remove)."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/drl990114/MarkFlowy/releases/download/v1.2.3/MarkFlowy_v1.2.3_x64_portable.zip",
            "hash": "1904768838d0aaec90c27016de796cfe12755ef689f1cb301dc001d689166f7b"
        }
    },
    "extract_dir": "MarkFlowy-portable",
    "bin": "MarkFlowy.exe",
    "shortcuts": [
        [
            "MarkFlowy.exe",
            "MarkFlowy"
        ]
    ],
    "post_install": [
        "Copy-Item \"$bucketsdir\\zibo-scoop-bucket\\scripts\\markflowy-file-assoc.ps1\" \"$dir\\markflowy-file-assoc.ps1\" -Force",
        "& powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$dir\\markflowy-file-assoc.ps1\""
    ],
    "uninstaller": {
        "script": "if (Test-Path \"$dir\\markflowy-file-assoc.ps1\") { & powershell.exe -ExecutionPolicy Bypass -File \"$dir\\markflowy-file-assoc.ps1\" -Uninstall }"
    },
    "checkver": {
        "github": "https://github.com/drl990114/MarkFlowy"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/drl990114/MarkFlowy/releases/download/v$version/MarkFlowy_v$version_x64_portable.zip",
                "hash": {
                    "url": "https://api.github.com/repos/drl990114/MarkFlowy/releases/latest",
                    "jsonpath": "$.assets[?(@.name=='MarkFlowy_v$version_x64_portable.zip')].digest"
                }
            }
        }
    }
