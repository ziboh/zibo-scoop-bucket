    "bin": "MarkFlowy.exe",
    "shortcuts": [
        [
            "MarkFlowy.exe",
            "MarkFlowy"
        ]
    ],
    "post_install": "Copy-Item \"$bucketsdir\\zibo-scoop-bucket\\scripts\\markflowy-file-assoc.ps1\" \"$dir\\markflowy-file-assoc.ps1\" -Force",
    "uninstaller": {
        "script": "if (Test-Path \"$dir\\markflowy-file-assoc.ps1\") { & powershell.exe -ExecutionPolicy Bypass -File \"$dir\\markflowy-file-assoc.ps1\" -Uninstall }"
